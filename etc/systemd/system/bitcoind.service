[Unit]
Description=Bitcoin Core Node (Project Overpass)
After=network.target

[Service]
User=nodeadmin
Group=nodeadmin
Type=simple
Restart=always
RestartSec=30

# Optimized for your External SSD
ExecStart=/snap/bin/bitcoin-core.bitcoind \
    -datadir=/mnt/bitcoin-vault/bitcoin \
    -conf=/mnt/bitcoin-vault/bitcoin/bitcoin.conf \
    -txindex=1 \
    -dbcache=4096 \
    -maxmempool=300 \
    -maxconnections=40

[Install]
WantedBy=multi-user.target
